<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootProductDetails"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/buttonBackProduct" android:layout_width="48dp"
                android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp" android:contentDescription="Voltar" android:src="@drawable/ic_back" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Detalhes do produto" android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonEditProduct"
                style="@style/Widget.ListaCompras.Button.Tonal"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Editar" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="220dp"
            android:layout_marginTop="12dp" android:background="?attr/colorSurfaceContainerLow">
            <ImageView android:id="@+id/imageProductDetails" android:layout_width="match_parent"
                android:layout_height="match_parent" android:scaleType="centerCrop"
                android:contentDescription="Foto do produto" />
            <TextView android:id="@+id/textImagePlaceholder" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center" android:text="📷  Sem foto"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonGalleryProduct"
                style="@style/Widget.ListaCompras.Button.Outlined" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="Galeria" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonCameraProduct"
                style="@style/Widget.ListaCompras.Button.Outlined" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
                android:text="Câmera" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonRemovePhoto"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Remover" />
        </LinearLayout>
        <TextView android:id="@+id/textProductName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" />
        <TextView android:id="@+id/textProductMeta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.ListaCompras.Card.Subtle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="16dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PREÇOS E PAGAMENTO" android:textColor="?attr/colorPrimary"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />
                <TextView android:id="@+id/textProductPayment" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
                <TextView android:id="@+id/textProductWarning" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="9dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorError" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/textProductNotes" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.ListaCompras.Card"
            android:id="@+id/cardProductLinks" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="LINKS DAS LOJAS" android:textStyle="bold"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                <TextView android:id="@+id/textPrimaryLinkTitle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="Anúncio principal"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <LinearLayout android:id="@+id/rowPrimaryLinks"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout android:id="@+id/buttonOpenProductUrl"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:minHeight="76dp"
                        android:padding="8dp" android:orientation="vertical"
                        android:gravity="center" android:clickable="true"
                        android:focusable="true" android:background="?attr/selectableItemBackground"
                        android:contentDescription="Abrir link do produto">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_link_open" android:importantForAccessibility="no"
                            app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:gravity="center"
                            android:maxLines="1" android:text="Abrir"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/buttonCopyProductUrl"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:minHeight="76dp"
                        android:padding="8dp" android:orientation="vertical"
                        android:gravity="center" android:clickable="true"
                        android:focusable="true" android:background="?attr/selectableItemBackground"
                        android:contentDescription="Copiar link do produto">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_link_copy" android:importantForAccessibility="no"
                            app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:gravity="center"
                            android:maxLines="1" android:text="Copiar"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/buttonShareProductUrl"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:minHeight="76dp"
                        android:padding="8dp" android:orientation="vertical"
                        android:gravity="center" android:clickable="true"
                        android:focusable="true" android:background="?attr/selectableItemBackground"
                        android:contentDescription="Compartilhar link do produto">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_link_share" android:importantForAccessibility="no"
                            app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:gravity="center"
                            android:maxLines="1" android:text="Compartilhar"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/textAlternativeLinkTitle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="Outra oferta"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <LinearLayout android:id="@+id/rowAlternativeLinks"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout android:id="@+id/buttonOpenAlternativeUrl"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:minHeight="76dp"
                        android:padding="8dp" android:orientation="vertical"
                        android:gravity="center" android:clickable="true"
                        android:focusable="true" android:background="?attr/selectableItemBackground"
                        android:contentDescription="Abrir oferta alternativa">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_link_open" android:importantForAccessibility="no"
                            app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:gravity="center"
                            android:maxLines="1" android:text="Abrir"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/buttonCopyAlternativeUrl"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:minHeight="76dp"
                        android:padding="8dp" android:orientation="vertical"
                        android:gravity="center" android:clickable="true"
                        android:focusable="true" android:background="?attr/selectableItemBackground"
                        android:contentDescription="Copiar oferta alternativa">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_link_copy" android:importantForAccessibility="no"
                            app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:gravity="center"
                            android:maxLines="1" android:text="Copiar"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/buttonShareAlternativeUrl"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:minHeight="76dp"
                        android:padding="8dp" android:orientation="vertical"
                        android:gravity="center" android:clickable="true"
                        android:focusable="true" android:background="?attr/selectableItemBackground"
                        android:contentDescription="Compartilhar oferta alternativa">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_link_share" android:importantForAccessibility="no"
                            app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:gravity="center"
                            android:maxLines="1" android:text="Compartilhar"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
